function generateToken() {
    const now = new Date();
    
    // Get individual components of the current date and time
    const year = now.getFullYear().toString().slice(-2); // last 2 digits of the year
    const month = ("0" + (now.getMonth() + 1)).slice(-2); // months are zero-indexed, so add 1
    const day = ("0" + now.getDate()).slice(-2);
    const hours = ("0" + now.getHours()).slice(-2);
    const minutes = ("0" + now.getMinutes()).slice(-2);
    const seconds = ("0" + now.getSeconds()).slice(-2);
    
    // Combine components to create a 6-digit token
    const token = (year + month + day + hours + minutes + seconds).slice(-6); // Take the last 6 digits
    
    return token;
}




function createPrintLayout(data) {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    // Title
    doc.setFontSize(16);
    doc.setTextColor(40);
    doc.text('Customer Pledge Receipt', 70, 15);

    // Customer Info Table
    const tableData = [
        ['Date', data.date],
        ['Token No.', data.tokenno],
        ['Customer Name', data.customerName],
        ['Father Name', data.father_name],
        ['Phone Number', data.number],
        ['Item Name', data.item_name],
        ['Amount', data.amount],
        ['Rate of Interest (%)', `${data.rate_of_interest}%`],
        ['Address', data.address]
        ['Item Description', data.item_description],

    ];

    doc.autoTable({
        startY: 25,
        head: [['Field', 'Details']],
        body: tableData,
        styles: {
            fontSize: 11,
            cellPadding: 4,
        },
        headStyles: {
            fillColor: [52, 152, 219], // Blue Header
            textColor: 255,
            halign: 'left',
        },
        alternateRowStyles: {
            fillColor: [240, 240, 240], // Light gray for alternate rows
        },
    });

    // Save PDF
    const fileName = `Customer_${data.customerName}_${data.date}.pdf`;
    const pdfBlob = doc.output('blob');
    const pdfURL = URL.createObjectURL(pdfBlob);

    // Download link
    const downloadLink = document.createElement('a');
    downloadLink.href = pdfURL;
    downloadLink.download = fileName;
    downloadLink.click();

    // WhatsApp sharing
    const whatsappMessage = `🧾 *Customer Receipt* \n\n👤 Name: ${data.customerName}\n💰 Amount: ${data.amount}\n📅 Date: ${data.date}\n🔖 Token No.: ${data.tokenno}\n\n🔗 PDF: ${pdfURL}`;
    const customerPhoneNumber = `91${data.number.replace(/\s/g, '')}`;
    const whatsappLink = `https://api.whatsapp.com/send?phone=${customerPhoneNumber}&text=${encodeURIComponent(whatsappMessage)}`;

    window.open(whatsappLink, '_blank');
}


