<script>

function submitForm() {
    const customerid = $('#customerSelect').val();
    const father_name = $('#father_name').val();
    const number = $('#number').val();
    const item_name = $('#item_name').val();
    const item_weight = $('#item_weight').val();
    const amount = $('#amount').val();
    const photo = $('#photo')[0].files[0];
    const item_description = $('#item_description').val();
    const rate_of_interest = $('#rate_of_interest').val();
    const date = $('#date').val();
    const address = $('#address').val();
    const customerName = $('#customerSelect option:selected').text().split(' S/O ')[0].trim();
    const tokenno = generateToken();

    if (!customerid || !father_name || !item_name  || !amount || !photo) {
        alert('Please fill all required fields and select an image');
        return;
    }

    const loaderOverlay = document.getElementById("loader-overlay");
    loaderOverlay.style.display = "flex";

    const formData = new FormData();
    formData.append("customerid", customerid);
    formData.append("item_name", item_name);
    formData.append("item_weight", item_weight);
    formData.append("photo", photo);
    formData.append("item_description", item_description);
    formData.append("rate_of_interest", rate_of_interest);
    formData.append("amount", amount);
    formData.append("tokenno", tokenno);
    formData.append("created_at", date);
    // formData.append("address", address);

    fetch("/dashboard/data/loan/insert", {
        method: "POST",
        body: formData
    })
    .then((response) => response.json())
    .then((data) => {
        loaderOverlay.style.display = "none";
        if (data.msg == "success") {
            alert('Loan Submitted Succesfully')
            // createPrintLayout({
            //     customerName,
            //     father_name,
            //     number,
            //     item_name,
            //     item_weight,
            //     photo,
            //     item_description,
            //     rate_of_interest,
            //     address,
            //     date,
            //     amount,
            //     tokenno
            // });
        } else {
            alert("Error: Something went wrong");
        }
    })
    .catch((error) => {
        loaderOverlay.style.display = "none";
        console.error("Error:", error);
        alert("An error occurred. Please try again.");
    });
}


  </script>
  
