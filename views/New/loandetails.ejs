<%- include('.././header.ejs') %>

<!-- SwiperJS CDN -->
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
 <!-- Bootstrap 5 CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Bootstrap 5 JS (for modal functionality) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


<style>
  .zoomable-image {
    transition: transform 0.3s ease;
    cursor: zoom-in;
  }

  .zoomable-image:hover {
    transform: scale(1.05);
  }

  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>


	<div class="hk-pg-wrapper">
  <div class="container-fluid py-4">
   <div class="card shadow-sm">
      <div class="card-header text-white" style="background-color: #004d52;color: white;">
        <h5 class="mb-0" style="color: white;">Loan Details (ग्राहक की सूची)  </h5>
      </div>
      </div>


      <% if (result[0].status === 'clear') { %>
  <div class="alert alert-success mt-3 mb-0 fw-semibold">
    ✅ This loan has already been <strong>cleared</strong> on <strong><%= result[0].updated_at %></strong>.
  </div>
<% } %>


      <!-- Modal: Clear Loan Date Input -->
<div class="modal fade" id="clearLoanModal" tabindex="-1" aria-labelledby="clearLoanModalLabel" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable d-flex justify-content-center">
    <form id="clearLoanForm" method="POST" action="/dashboard/clear/loan">
      <div class="modal-content">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title" id="clearLoanModalLabel">Select Clearance Date</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="loanid" value="<%= result[0].id %>">
          <div class="mb-3">
            <label for="cleardate" class="form-label">Clearance Date</label>
            <input type="date" class="form-control" id="cleardate" name="cleardate" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="submit" class="btn btn-danger">Confirm & Clear Loan</button>
        </div>
      </div>
    </form>
  </div>
</div>

     
    
    <div class="row align-items-stretch">
  <!-- Customer Personal Details -->
  <div class="col-12 col-sm-12 col-lg-6" style="margin-bottom: 20px;">
    <div class="card h-100" style="margin-top: 20px;">
      <div class="card-header text-white" style="background-color: #004d52;">
        <strong>1. Customer Personal Details</strong>
      </div>
      <div class="card-body p-0">
        <table class="table table-bordered mb-0">
          <tbody>
            <tr><th>Name</th><td><%= result[0].customername.toUpperCase() %></td></tr>
            <tr><th>Father's Name</th><td><%= result[0].customerfather_name.toUpperCase() %></td></tr>
            <tr><th>Contact</th><td><%= result[0].customernumber %></td></tr>
            <tr><th>Address</th><td><%= result[0].customeraddress %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Loan Details -->
  <div class="col-12 col-sm-12 col-lg-6">
    <div class="card h-100" style="margin-top: 20px;">
      <div class="card-header text-white" style="background-color: #004d52;">
        <strong>2. Loan Details</strong>
      </div>
      <div class="card-body p-0">
        <table class="table table-bordered mb-0">
          <tbody>
            <tr><th>Item Name</th><td><%= result[0].item_name %></td></tr>
            <% if (result[0].item_description) { %>
              <tr><th>Description</th><td><%= result[0].item_description %>
            </td></tr>
            <% } %>
            <tr><th>Date</th><td><%= result[0].created_at %></td></tr>
            <tr><th>Amount</th><td>₹<%= result[0].amount %></td></tr>
            <tr><th>Interest Rate</th><td><%= result[0].rate_of_interest %>%</td></tr>
            <tr>
              <th>Duration</th>
              <td>
                <% if (result[0].timeDiff.years > 0) { %> <%= result[0].timeDiff.years %> Years <% } %>
                <% if (result[0].timeDiff.months > 0) { %> <%= result[0].timeDiff.months %> Months <% } %>
                <% if (result[0].timeDiff.days > 0) { %> <%= result[0].timeDiff.days %> Days <% } %>
                <% if (result[0].timeDiff.years === 0 && result[0].timeDiff.months === 0 && result[0].timeDiff.days === 0) { %>
                  Less than a day
                <% } %>
              </td>
            </tr>
            <tr><th>Interest Amount</th><td>₹<%= result[0].interestAmount.toFixed(2) %></td></tr>
          <tr>
  <th>Image</th>
  <td>
    <img src="/uploads/<%= result[0].photo %>" style="width:100px; cursor: zoom-in;" onclick="showImageModal('<%= result[0].photo %>')">
  </td>
</tr>  

          

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="imageZoomModal" tabindex="-1" aria-labelledby="imageZoomModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content bg-dark">
      <div class="modal-body p-0 text-center">
        <img id="zoomedImage" src="" class="img-fluid w-100" style="max-height: 90vh; object-fit: contain;" />
      </div>
    </div>
  </div>
</div>

    <!-- SECTION 1: Personal Details -->
    


    <!-- SECTION 2: Loan Details -->

      


    <!-- SECTION 3: Loan Images -->
<!-- SECTION 3: Loan Images -->



    <!-- SECTION 4: Upload Loan Clearance Proof -->


  <% if(result[0].status == 'clear') { %>


    <% } else { %>

<div class="card mt-8 mb-5">
  <div class="card-header text-white" style="background-color: #004d52;">
    <strong>4. Loan Actions</strong>
  </div>
  <div class="card-body text-center">
    
    

    <% if (result[0].istransfer === 'yes') { %>
      <div class="alert alert-success fw-semibold" role="alert">
        ✅ This loan has already been <strong>transferred</strong> to <u><%= result[0].investorname %></u> on <strong><%= result[0].transfer_date %></strong>.
      </div>

       <button class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#clearLoanModal">
  <i class="bi bi-check-circle"></i> Clear Loan
</button>

    <% } else { %>
      <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
        <a href="/loan/transfer?loanid=<%= result[0].id %>" class="btn btn-outline-primary btn-lg">
          <i class="bi bi-arrow-left-right"></i> Transfer Loan
        </a>
       <button class="btn btn-danger btn-lg" data-bs-toggle="modal" data-bs-target="#clearLoanModal">
  <i class="bi bi-check-circle"></i> Clear Loan
</button>

      </div>
    <% } %>

  </div>
</div>
        <% } %>

<!-- SECTION 4: Loan Actions -->



    <!-- SECTION 5: Action Buttons -->



    
  
</div>






<%- include('.././footer.ejs') %>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Swiper Init Script -->
<script>
  const swiper = new Swiper(".mySwiper", {
    slidesPerView: 3,
    spaceBetween: 20,
    loop: true,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    breakpoints: {
      320: { slidesPerView: 1 },
      768: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
    },
  });
</script>

<!-- Zoom on Hover CSS -->
<style>
  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .zoom-image {
    transition: transform 0.3s ease;
    cursor: zoom-in;
  }

  .zoom-image:hover {
    transform: scale(1.1);
  }
</style>


<script>
  function showImageModal(imageUrl) {
    document.getElementById('zoomedImage').src = imageUrl;
    const modal = new bootstrap.Modal(document.getElementById('imageZoomModal'));
    modal.show();
  }
</script>
