
		<!-- /Top Navbar -->
        <%- include ('.././header.ejs') %>

      
        <style>
  .card.card-wth-line {
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease;
    background-color: #ffffff;
  }

  .card.card-wth-line:hover {
    transform: translateY(-3px);
  }

  .card .card-title {
    font-size: 16px;
    color: #333333;
  }

  .card .card-footer {
    background-color: #f9f9f9;
    font-weight: 600;
    padding: 12px 16px;
    border-top: 1px solid #e0e0e0;
  }

  .pg-title {
    font-size: 28px;
    font-weight: bold;
    color: #004d52;
  }

  .hk-pg-header p {
    font-size: 14px;
    color: #777;
  }

  .card-body img {
    max-width: 36px;
    margin-right: 10px;
  }
</style>


		<!-- Chat Popup -->
		
           
          
            <!-- Main Content -->
            <div class="hk-pg-wrapper">
            <div class="container-xxl">

                
                <!-- Page Header -->
                <div class="hk-pg-header pg-header-wth-tab pt-7">
                    <div class="d-flex">
                        <div class="d-flex flex-wrap justify-content-between flex-1">
                            <div class="mb-lg-0 mb-2 me-8">
                                <h1 class="pg-title">Welcome back</h1>
                                <p>TrakMoney Fund Management Dashboard</p>
                                                     <div id="qrCodeContainer">
  <h3>Scan this QR code to open site on your mobile:</h3>
  <img src="https://api.qrserver.com/v1/create-qr-code/?data=<%= encodeURIComponent(qrUrl) %>&size=100x100" alt="QR Code" />
</div>

<script>
  // Simple mobile detection based on screen width or user agent
  const isMobile = window.innerWidth <= 768 || /Mobi|Android/i.test(navigator.userAgent);

  if (isMobile) {
    document.getElementById('qrCodeContainer').style.display = 'none';
  }
</script>
                            </div>


    

  
                            <div class="pg-header-action-wrap">
                                <div class="input-group w-300p">
                                    <span class="input-affix-wrapper">
                                        <span class="input-prefix"><span class="feather-icon"><i data-feather="calendar"></i></span></span>
                                        <input class="form-control form-wth-icon" name="date" id="date" readonly>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
              
                </div>
                <!-- /Page Header -->
            
                <!-- Page Body -->
                <div class="hk-pg-body">


														
                    <div class="row">
                        <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                            <div class="card card-wth-line">
                                <div class="card-line bg-success"></div>
                                <div class="card-body" style="display: flex; align-items: center;">
                                    <img src="https://img.icons8.com/?size=40&id=Bw1qS7FPUzIJ&format=png&color=00D67F" style="margin-right: 8px;">
                                    <h5 class="card-title" style="margin: 0;font-weight: bold;">Active Funds (रखे हुए गहने)</h5>
                                </div>
                                <div class="card-footer" style="color: black;font-size: 18px;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(loanResults[0].total_pending) %>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                            <div class="card card-wth-line">
                                <div class="card-line bg-primary"></div>
                                <div class="card-body" style="display: flex; align-items: center;">
                                    <img src="https://img.icons8.com/?size=40&id=FJ5UK7RNoMoB&format=png&color=007D88" style="margin-right: 8px;">
                                    <h5 class="card-title" style="margin: 0;font-weight: bold;">Transferred Funds (ट्रांसफर किए गए गहने)</h5>
                                </div>
                                <div class="card-footer" style="color: black;font-size: 18px;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(loanResults[0].total_transferred) %>


                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                            <div class="card card-wth-line">
                                <div class="card-line bg-warning"></div>
                                <div class="card-body" style="display: flex; align-items: center;">
                                    <img src="https://img.icons8.com/?size=40&id=112571&format=png&color=FFC400" style="margin-right: 8px;">
                                    <h5 class="card-title" style="margin: 0;font-weight: bold;">Own Funds (मेरे पास के गहने)</h5>
                                </div>
                                <div class="card-footer" style="color: black;font-size: 18px;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(loanResults[0].total_not_transferred) %>


                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                            <div class="card card-wth-line">
                                <div class="card-line bg-danger"></div>
                                <div class="card-body" style="display: flex; align-items: center;">
                                    <img src="https://img.icons8.com/?size=40&id=113106&format=png&color=FF0000" style="margin-right: 8px;">
                                    <h5 class="card-title" style="margin: 0;font-weight: bold;">1 year old Funds (एक साल पुराने गहने)</h5>
                                </div>
                                <div class="card-footer" style="color: black;font-size: 18px;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(loanResults[0].total_amount_last_year) %>
                                   

                                </div>
                            </div>
                        </div>
                        </div>
                                                                            

                        <div class="hk-pg-header pg-header-wth-tab pt-7">
                            <div class="d-flex">
                                <div class="d-flex flex-wrap justify-content-between flex-1">
                                    <div class="mb-lg-0 mb-2 me-8">
                                        <h1 class="pg-title">Investor</h1>
                                    </div>
                                   
                                </div>
                            </div>
                      
                        </div>


                        <div class="row" style="margin-top: 20px;">

                          <% for(i=0;i<investorResults.length;i++){ %>

                            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                                <div class="card card-wth-line">
                                    <div class="card-line bg-primary"></div>
                                    <div class="card-body">
                                        <h5 class="card-title"><%=investorResults[i].name%></h5>
                                    </div>
                                    <div class="card-footer" style="color: black;font-size: 18px;">
                                    <%= new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(investorResults[i].total_invested) %>
                                       
                                    </div>
                                </div>
                            </div>
                          
                            

                            <% } %>
                            </div>
             
                </div>
                <!-- /Page Body -->		
            </div>

<%- include ('.././footer.ejs') %>
		