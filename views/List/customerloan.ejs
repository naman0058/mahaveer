<script>
  $(document).on('click', '.editLoanBtn', function () {
    const data = $(this).data();

    $('#editLoanId').val(data.id);
    $('#editCustomerName').val(data.customername + ' S/O ' + data.customerfather);
    $('#editItemName').val(data.item);
    $('#editLoanAmount').val(data.amount);
    $('#editLoanDescription').val(data.description);

    // const photoUrl = `/images/${data.photo}`;
    const photoUrl = `/uploads/${data.photo}`;

    $('#existingLoanPhoto').attr('src', photoUrl);

    $('#loanPhotoPreview').attr('src', '#').addClass('d-none');
    $('#editLoanModal').modal('show');
  });

  $('#editLoanPhoto').on('change', function () {
    const reader = new FileReader();
    reader.onload = function (e) {
      $('#loanPhotoPreview').attr('src', e.target.result).removeClass('d-none');
    };
    if (this.files[0]) {
      reader.readAsDataURL(this.files[0]);
    }
  });
</script>

